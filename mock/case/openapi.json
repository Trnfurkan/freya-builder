 "paths": {
  "/cards.list": {
   "post": {
    "operationId": "cards_list",
    "summary": "The customer's cards the assistant may talk about.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "data"
        ],
        "properties": {
         "data": {
          "type": "object",
          "required": [
           "customerNo",
           "aiFlow"
          ],
          "properties": {
           "customerNo": {
            "type": "string",
            "description": "The customer number of the call."
           },
           "aiFlow": {
            "type": "string",
            "enum": [
             "CardOps"
            ]
           }
          }
         },
         "call": {
          "type": "object",
          "properties": {
           "ani": {
            "type": "string"
           },
           "lang": {
            "type": "string",
            "enum": [
             "tr"
            ]
           }
          }
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Success: result.returnCode \"1\".",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "data": {
           "type": "object",
           "properties": {
            "cards": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "cardNumber": {
                "type": "string"
               },
               "cardNumberLast4": {
                "type": "string"
               },
               "productName": {
                "type": "string"
               },
               "status": {
                "type": "string"
               },
               "isMainCard": {
                "type": "boolean"
               }
              }
             }
            },
            "validCardsCount": {
             "type": "number"
            },
            "exitState": {
             "type": "string"
            }
           }
          },
          "result": {
           "type": "object",
           "properties": {
            "guid": {
             "type": "string"
            },
            "returnCode": {
             "type": "string"
            },
            "messageText": {
             "type": "string"
            },
            "code": {
             "type": "string"
            },
            "message": {
             "type": "string"
            },
            "type": {
             "type": "string"
            },
            "details": {
             "type": "object",
             "properties": {
              "guid": {
               "type": "string"
              },
              "rootCause": {
               "type": "string"
              },
              "errorOrigin": {
               "type": "string"
              }
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "INVALID_ARGUMENTS_ERROR: a required field is missing or empty. Only result, no data."
     },
     "500": {
      "description": "FBE00099: technical error on the bank's side. Only result, no data."
     },
     "404": {
      "description": "FB_IVR_CHANNEL_102 (WARNING): Müşteriye ait geçerli kart bilgisi bulunamadı. Only result, no data."
     }
    }
   }
  },
